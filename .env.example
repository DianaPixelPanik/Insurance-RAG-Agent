# Anthropic Claude
ANTHROPIC_API_KEY=""

# OpenAI (used for embeddings)
OPENAI_API_KEY=""

# PostgreSQL
PG_DB_NAME=postgres
PG_USER=postgres
PG_PASSWORD=<YOUR_POSTGRES_PASSWORD>
PG_HOST=localhost
PG_PORT=5432
PG_DB_URL="postgresql://<YOUR_POSTGRES_USER>:<YOUR_POSTGRES_PASSWORD>@localhost:5432/<YOUR_POSTGRES_DB_NAME>"

# Milvus (optional, for vector search via syncing_databases.py)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Backend URL (used by Streamlit)
BACKEND_URL=http://localhost:8000
